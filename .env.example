# =====================================================================
#  Frontend (Next.js) environment — copy to `.env.local` for local work,
#  or paste these keys into Vercel → Project → Settings → Environment
#  Variables for Preview + Production.
#
#  docker-compose also reads a root `.env` file, so the compose overrides
#  at the bottom live here too. Never commit the filled-in copies:
#  `.gitignore` excludes `.env*` and whitelists only this template.
# =====================================================================

# ---- Database (required for live data) ------------------------------
# The app is host-agnostic — the URL alone selects the driver:
#   *.neon.tech           → Neon HTTP driver (serverless-optimized)
#   anything else         → node-postgres over TCP (Railway, local Postgres)
#
# Railway: Postgres service → Variables → DATABASE_PUBLIC_URL
#   (use the PUBLIC url from Vercel — `postgres.railway.internal` is only
#    reachable from inside Railway's private network)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# POSTGRES_URL is accepted as an alias (what the Neon/Vercel integration sets).

# Optional overrides ---------------------------------------------------
# Force the driver when auto-detection is wrong: neon | pg
# DB_DRIVER=pg
# Connections per warm serverless instance. Keep small: Vercel runs many
# instances and a managed Postgres has a hard connection ceiling.
# DB_POOL_MAX=2
# Verify the server certificate. Managed proxies (Railway) present certs that
# do not chain to a public root, so this is off unless you supply PGSSLROOTCERT.
# DB_SSL_REJECT_UNAUTHORIZED=false

# ---- Scheduled ingestion --------------------------------------------
# Gates GET /api/cron/ingest. Vercel Cron sends it as `Authorization: Bearer`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Optional connectors --------------------------------------------
# US SAM.gov stays dormant (skipped silently) without a key.
SAM_GOV_API_KEY=

# ---- FastAPI service on Railway --------------------------------------
# Public URL of the Railway backend (https://<service>.up.railway.app).
# Exposed so the deployed frontend never hardcodes a host; the current read
# path queries Postgres directly, so this is configuration for the backend's
# own consumers (Swagger, integrations) rather than a runtime dependency.
NEXT_PUBLIC_API_BASE=
# Server-side equivalent. Under docker-compose this is the in-network address.
API_BASE=

# ---- docker-compose overrides (all optional — defaults match the old
#      hardcoded values exactly, so `docker compose up` is unchanged) ----
# POSTGRES_DB=discovery
# POSTGRES_USER=discovery
# POSTGRES_PASSWORD=discovery
# BACKEND_PORT=8080
# FRONTEND_PORT=3000
# JWT_SECRET=change-me-in-production-please-32-bytes-minimum!
# ALLOWED_ORIGINS=http://localhost:3000
# Point the compose frontend at the compose Postgres (empty = seed dataset,
# which is the current behaviour).
# FRONTEND_DATABASE_URL=postgresql://discovery:discovery@postgres:5432/discovery
