# --- Node / Next.js -----------------------------------------------------
# UNANCHORED on purpose. These were `/node_modules`, `/.next` and so on, and a
# leading slash pins a pattern to the repository root — which was correct while
# the Next.js app WAS the repository root. Once it moved to frontend/, those
# patterns silently stopped matching: `git status` offered to commit
# frontend/node_modules, roughly half a gigabyte of dependencies.
#
# A trailing slash with no leading one matches the directory at ANY depth, so
# this now covers frontend/, a future second app, and the root alike.
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.vercel/

# --- Python -------------------------------------------------------------
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Secrets & local env -------------------------------------------------
# Every .env variant is ignored; the committed templates are the exception.
# Keep the negations last — a later `.env*` line would silently re-ignore them.
.env*
!.env.example
!backend/.env.example
*.pem

# --- Runtime artifacts ---------------------------------------------------
captures/
*.log

# --- Local archives ------------------------------------------------------
# backend.zip is ~283 MB. Vercel has no .vercelignore here, so it falls back
# to this file when choosing what to upload — leaving the archive out of it
# failed the deploy on the 100 MB upload limit.
/backend.zip

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
