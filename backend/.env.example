# =====================================================================
#  Backend (FastAPI) environment.
#
#  Local: copy to backend/.env — or do nothing, docker-compose already
#  passes every value it needs.
#  Railway: Service → Variables. DATABASE_URL and PORT are injected for you
#  (DATABASE_URL by referencing the Postgres service), so only the rest of
#  this file needs entering.
# =====================================================================

# ---- Database --------------------------------------------------------
# Preferred, and what Railway injects. Reference the Postgres service so the
# value tracks credential rotation:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Use the PRIVATE url (postgres.railway.internal) between Railway services —
# it is faster and not billed as egress.
DATABASE_URL=

# Legacy/compose fallback, used only when DATABASE_URL is empty. Accepts the
# JDBC-style form docker-compose passes.
# DB_URL=jdbc:postgresql://postgres:5432/discovery
# DB_USER=discovery
# DB_PASSWORD=discovery

# Connections held per worker process. Effective total = this x WEB_CONCURRENCY;
# keep the product under the plan's connection limit.
# DB_POOL_SIZE=20
# DB_POOL_RECYCLE_SECONDS=1800
# Force TLS to the database ("require"). Empty lets psycopg negotiate, which is
# correct for both the plaintext compose network and Railway's proxy.
# DB_SSLMODE=

# ---- CORS ------------------------------------------------------------
# Comma-separated exact origins. Development keeps localhost; production adds
# the Vercel domain.
ALLOWED_ORIGINS=http://localhost:3000,https://<your-project>.vercel.app
# Vercel preview deployments get a unique hostname each time, so match them by
# pattern instead of listing them. Leave empty to allow no previews.
# ALLOWED_ORIGIN_REGEX=^https://<your-project>-[a-z0-9-]+\.vercel\.app$

# ---- Auth ------------------------------------------------------------
# 32+ bytes. Generate with: openssl rand -hex 32
JWT_SECRET=
# JWT_TTL_MINUTES=60

# ---- Runtime ---------------------------------------------------------
# Injected by Railway; leave unset locally so the image keeps using 8080.
# PORT=8080
# Uvicorn worker processes. Safe to raise only while the scheduler is off.
# WEB_CONCURRENCY=2

# ---- Scheduled ingestion --------------------------------------------
# The in-process APScheduler is disabled automatically on Railway, because
# Vercel Cron (GET /api/cron/ingest) owns ingestion for the deployed portal and
# two schedulers would collect every source twice. Set explicitly to override:
#   true  = run collection cadences in this process
#   false = never run them
# SCHEDULER_ENABLED=false

# ---- Optional --------------------------------------------------------
# REDIS_HOST=redis
# REDIS_PORT=6379
# Directory for raw connector response captures (provenance evidence).
# CONNECTOR_CAPTURE_DIR=/tmp/captures
